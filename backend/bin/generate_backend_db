def fill_condensed_and_taxonomy_tables(
        db, db_path, condensed_otu_table_path, blacklist, run_accession_to_id,
        taxonomy_type, taxonomy_name_to_id=None, next_taxonomy_id=None, allow_new_taxa=True):
    if taxonomy_name_to_id is None:
        taxonomy_name_to_id = {}
    if taxonomy_type not in taxonomy_name_to_id:
        taxonomy_name_to_id[taxonomy_type] = {}
    if next_taxonomy_id is None:
        next_taxonomy_id = (db.session.query(func.max(Taxonomy.id)).scalar() or 0) + 1
    count = db.session.query(CondensedProfile).count()
    sample_count = 0

    current_sample = None
    current_sample_entries = []
    logging.info("Processing condensed profiles and associated taxonomy tables ..")

    skipped_runs = set()

    compute_known_species = taxonomy_type in ('gtdb', 'globdb')
    known_species_field = (
        'known_species_fraction'
        if taxonomy_type == 'gtdb'
        else 'globdb_known_species_fraction'
    )
    # Per-taxonomy "nothing assigned below domain-level" flag. A sample is
    # domain-only if none of its condensed rows resolve past domain (i.e. no
    # entry deeper than "Root; d__X"). Written to the column matching this load;
    # domain_only_both is derived from the pair in the 'tags' stage.
    domain_only_field = (
        'domain_only_gtdb' if taxonomy_type == 'gtdb' else 'domain_only_globdb'
    )
    current_sample_species_coverage = 0.0
    current_sample_non_species_coverage = 0.0
    current_sample_has_below_domain = False
    known_species_fractions = []

    with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8') as tf:
        for row in iterate_condensed_profiles(condensed_otu_table_path, blacklist):
            if row[0] not in run_accession_to_id:
                skipped_runs.add(row[0])
                continue

            # Calculate per-sample because we need to calculate relative abundance within-sample
            if row[0] != current_sample:
                if current_sample is not None:
                    (taxonomy_name_to_id, next_taxonomy_id,
                     count) = fill_a_condensed_profile_sample(db, run_accession_to_id, current_sample_entries,
                                                              taxonomy_name_to_id, next_taxonomy_id, count, tf,
                                                              taxonomy_type, allow_new_taxa)
                    if compute_known_species:
                        known_species_fractions.append({
                            'id': run_accession_to_id[current_sample],
                            known_species_field: current_sample_species_coverage / (
                                current_sample_species_coverage + current_sample_non_species_coverage),
                            domain_only_field: not current_sample_has_below_domain})
                current_sample = row[0]
                current_sample_entries = []
                sample_count += 1
                current_sample_species_coverage = 0.0
                current_sample_non_species_coverage = 0.0
                current_sample_has_below_domain = False
                if sample_count % 10000 == 0:
                    logging.info("Processed condensed profiles for {} samples".format(sample_count))

            current_sample_entries.append(row)
            if compute_known_species:
                if '; s__' in row[2]:
                    current_sample_species_coverage += float(row[1])
                else:
                    current_sample_non_species_coverage += float(row[1])
                # More than "Root; d__X" => this sample resolves below domain.
                if len(row[2].split('; ')) > 2:
                    current_sample_has_below_domain = True

        if current_sample is not None:
            (taxonomy_name_to_id, next_taxonomy_id,
             count) = fill_a_condensed_profile_sample(db, run_accession_to_id, current_sample_entries,
                                                      taxonomy_name_to_id, next_taxonomy_id, count, tf,
                                                      taxonomy_type, allow_new_taxa)
            if compute_known_species:
                known_species_fractions.append({
                    'id': run_accession_to_id[current_sample],  # We test that id == run_id in the add_smf function
                    known_species_field: current_sample_species_coverage / (
                        current_sample_species_coverage + current_sample_non_species_coverage),
                    domain_only_field: not current_sample_has_below_domain})

        # Commit taxonomy entries
        logging.info("Committing taxonomy entries from condensed profiles ..")
        db.session.commit()

        logging.info("Committing condensed profiles ..")
        tf.flush()
        conn = db.session.connection().connection
        conn.execute(
            f"COPY condensed_profiles FROM '{tf.name}' (DELIMITER '\t');"
        )
        conn.commit()
        logging.info("Wrote {} condensed profile rows to DB, skipping {} that were not in metadata".format(
            count, len(skipped_runs)))

        # Commit known species fractions
        if compute_known_species:
            logging.info("Committing known species fractions ..")
            db.session.bulk_update_mappings(ParsedSampleAttribute, known_species_fractions)
            db.session.commit()
            logging.info(
                "Wrote {} known species fractions to DB".format(
                    len(known_species_fractions)
                )
            )

    return taxonomy_name_to_id, next_taxonomy_id


def iterate_condensed_profiles(condensed_otu_table_path, blacklist):
    first = True
    for row in iterate_condensed_profile_reader_gzip_or_not(condensed_otu_table_path):
        if first:
            if len(row) != 3:
                raise Exception("Condensed profile file has unexpected number of columns: {}".format(len(row)))
            first = False
            continue
        if row[0] in blacklist:
            continue
        yield row


def iterate_condensed_profile_reader_gzip_or_not(condensed_otu_table_path):
    if condensed_otu_table_path.endswith('.gz'):
        with gzip.open(condensed_otu_table_path, 'rt') as csvfile_in:
            reader = csv.reader(csvfile_in, delimiter="\t")
            yield from reader
    else:
        with open(condensed_otu_table_path, 'r') as csvfile_in:
            reader = csv.reader(csvfile_in, delimiter="\t")
            yield from reader


def split_taxonomy_string(taxonomy_string):
    taxons_split = [tax.strip() for tax in taxonomy_string.split(';') if tax.strip() != '']
    if len(taxons_split) == 0:
        raise ValueError(f"Empty taxonomy string encountered: '{taxonomy_string}'")
    if taxons_split[0] != 'Root':
        taxons_split = ['Root'] + taxons_split
    return taxons_split


def taxonomy_level_from_taxon(taxon_name):
    if taxon_name == 'Root':
        return 'root'
    prefix = taxon_name.split('__')[0]
    level_map = {
        'd': 'domain',
        'p': 'phylum',
        'c': 'class',
        'o': 'order',
        'f': 'family',
        'g': 'genus',
        's': 'species',
    }
    if prefix not in level_map:
        raise KeyError(f"Unrecognised taxonomy prefix '{prefix}' for taxon '{taxon_name}'")
    return level_map[prefix]


def load_taxonomy_name_to_id(db, taxonomy_types=None):
    taxonomy_name_to_id = {}
    query = db.session.query(Taxonomy.id, Taxonomy.name, Taxonomy.taxonomy_type)
    if taxonomy_types is not None:
        query = query.filter(Taxonomy.taxonomy_type.in_(taxonomy_types))
    for tax_id, name, taxonomy_type in query:
        if taxonomy_type not in taxonomy_name_to_id:
            taxonomy_name_to_id[taxonomy_type] = {}
        taxonomy_name_to_id[taxonomy_type][name] = tax_id
    return taxonomy_name_to_id


def get_next_taxonomy_id(db):
    return (db.session.query(func.max(Taxonomy.id)).scalar() or 0) + 1


def add_taxonomy_path(db, taxons, taxonomy_type, taxonomy_name_to_id, next_taxonomy_id):
    if taxonomy_type not in taxonomy_name_to_id:
        taxonomy_name_to_id[taxonomy_type] = {}

    if 'Root' not in taxonomy_name_to_id[taxonomy_type]:
        existing_root = db.session.query(Taxonomy).filter(
            Taxonomy.taxonomy_type == taxonomy_type, Taxonomy.name == 'Root').one_or_none()
        if existing_root:
            taxonomy_name_to_id[taxonomy_type]['Root'] = existing_root.id
        else:
            db.session.add(Taxonomy(
                id=next_taxonomy_id,
                taxonomy_level='root',
                parent_id=None,
                name='Root',
                full_name='Root',
                taxonomy_type=taxonomy_type,
            ))
            db.session.flush()
            taxonomy_name_to_id[taxonomy_type]['Root'] = next_taxonomy_id
            next_taxonomy_id += 1

    for i, taxon in enumerate(taxons):
        if taxon in taxonomy_name_to_id[taxonomy_type]:
            continue

        taxonomy_level = taxonomy_level_from_taxon(taxon)
        parent_id = None if i == 0 else taxonomy_name_to_id[taxonomy_type][taxons[i - 1]]
        full_taxonomy = 'Root' if taxon == 'Root' else '; '.join(taxons[1:(i + 1)])

        db.session.add(Taxonomy(
            id=next_taxonomy_id,
            taxonomy_level=taxonomy_level,
            parent_id=parent_id,
            name=taxon,
            full_name=full_taxonomy,
            taxonomy_type=taxonomy_type,
        ))
        db.session.flush()
        taxonomy_name_to_id[taxonomy_type][taxon] = next_taxonomy_id
        next_taxonomy_id += 1

    return taxonomy_name_to_id, next_taxonomy_id


def add_taxonomy_from_tsv(db, taxonomy_path, taxonomy_type, taxonomy_name_to_id, next_taxonomy_id):
    logging.info("Reading taxonomy file %s for taxonomy type %s", taxonomy_path, taxonomy_type)
    opener = gzip.open if taxonomy_path.endswith('.gz') else open
    with opener(taxonomy_path, 'rt') as f:
        reader = csv.reader(f, delimiter='\t')
        for row in reader:
            if len(row) < 2:
                continue
            if row[1].lower().startswith('taxonomy'):
                continue
            if taxonomy_type=='globdb' and 'p_Unclassified' in row[1]:
                continue
            taxons = split_taxonomy_string(row[1])
            taxonomy_name_to_id, next_taxonomy_id = add_taxonomy_path(
                db, taxons, taxonomy_type, taxonomy_name_to_id, next_taxonomy_id)

    return taxonomy_name_to_id, next_taxonomy_id


def fill_a_condensed_profile_sample(db, run_accession_to_id, entries, taxonomy_name_to_id, next_taxonomy_id, count, tf,
                                   taxonomy_type, allow_new_taxa=True):
    total_coverage = sum([float(x[1]) for x in entries])

    # Generate WordNode tree so we can calculate relative abundance later
    root = WordNode(None, 'Root')
    taxons_to_wordnode = {root.word: root}

    inserted_taxonomy_ids = set()

    for row, taxons in iterate_condensed_profile_split_taxonomy(entries):
        coverage = float(row[1])
        taxonomy = row[2]
        logging.debug("Analysing taxonomy %s", taxonomy)

        last_taxon = root
        wn = None
        for (i, tax) in enumerate(taxons):
            if tax not in taxons_to_wordnode:
                wn = WordNode(last_taxon, tax)
                wn.coverage = 0
                logging.debug("Adding tax %s with prev %s", tax, last_taxon.word)
                last_taxon.children[tax] = wn
                taxons_to_wordnode[
                    tax] = wn  #TODO: Problem when there is non-unique labels? Require full taxonomy used?
            last_taxon = taxons_to_wordnode[tax]
        last_taxon.coverage = coverage

    for row, taxons in iterate_condensed_profile_split_taxonomy(entries):
        run_accession = row[0]
        run_id = run_accession_to_id[run_accession]

        # Get the taxonomy id, creating a new entry if necessary
        taxonomy_ids_here = []
        for (i, species_aware_taxonomy) in enumerate(taxons):
            if species_aware_taxonomy not in taxonomy_name_to_id[taxonomy_type]:
                if not allow_new_taxa:
                    raise ValueError(
                        f"Taxonomy '{species_aware_taxonomy}' missing for taxonomy type "
                        f"'{taxonomy_type}'. Please upload taxonomy before processing condensed profiles.")
                if species_aware_taxonomy == 'Root':
                    level = 'root'
                    parent_id = None
                    full_taxonomy = 'Root'
                else:
                    if i == 7:
                        level = 'species'
                    else:
                        prefix = species_aware_taxonomy.split('__')[0]
                        level_id = ['d', 'p', 'c', 'o', 'f', 'g', 's'].index(prefix)
                        level = ['domain', 'phylum', 'class', 'order', 'family', 'genus', 'species'][level_id]
                        # Will throw KeyError if something is amiss

                    parent_id = taxonomy_name_to_id[taxonomy_type][taxons[i - 1]]
                    full_taxonomy = '; '.join(taxons[1:(i + 1)])

                db.session.add(
                    Taxonomy(id=next_taxonomy_id,
                             taxonomy_level=level,
                             parent_id=parent_id,
                             name=species_aware_taxonomy,
                             full_name=full_taxonomy,
                             taxonomy_type=taxonomy_type))
                db.session.flush()

                taxonomy_name_to_id[taxonomy_type][species_aware_taxonomy] = next_taxonomy_id
                next_taxonomy_id += 1

            taxonomy_ids_here.append(taxonomy_name_to_id[taxonomy_type][species_aware_taxonomy])

        def add_a_condensed_profile_taxon(
                count, taxon_name, taxon_level_index,
                tf):  # db, , taxons_to_wordnode, taxonomy, taxonomy_ids_here, taxonomy_name_to_id
            # condensed_profile_entry = {
            #     'id': count+1,
            #     'run_id': run_id,
            #     'coverage': taxons_to_wordnode[taxon_name].coverage,
            #     'filled_coverage': taxons_to_wordnode[taxon_name].get_full_coverage(),
            #     'relative_abundance': taxons_to_wordnode[taxon_name].get_full_coverage() / total_coverage,
            #     'taxonomy_id': taxonomy_name_to_id[taxon_name]
            # }
            # for (idx, column_name) in zip(taxonomy_ids_here[:(taxon_level_index+1)], Taxonomy.taxonomy_level_columns):
            #     condensed_profile_entry[column_name] = idx
            # condensed_profile_entry = {
            #     'id': count+1,
            #     'run_id': run_id,
            #     'coverage': taxons_to_wordnode[taxon_name].coverage,
            #     'filled_coverage': taxons_to_wordnode[taxon_name].get_full_coverage(),
            #     'relative_abundance': taxons_to_wordnode[taxon_name].get_full_coverage() / total_coverage,
            #     'taxonomy_id': taxonomy_name_to_id[taxon_name]
            # }
            # for (idx, column_name) in zip(taxonomy_ids_here[:(taxon_level_index+1)], Taxonomy.taxonomy_level_columns):
            #     condensed_profile_entry[column_name] = idx
            # db.session.add(CondensedProfile(**condensed_profile_entry))
            # if count % 10000 == 0:
            #     db.session.commit()

            # id|run_id|coverage|filled_coverage|relative_abundance|taxonomy_id|domain_id|phylum_id|class_id|order_id|family_id|genus_id|species_id
            to_print = [
                count + 1,
                run_id,
                taxons_to_wordnode[taxon_name].coverage,
                taxons_to_wordnode[taxon_name].get_full_coverage(),
                taxons_to_wordnode[taxon_name].get_full_coverage() / total_coverage,
                taxonomy_name_to_id[taxonomy_type][taxon_name],
                taxonomy_type,
            ]
            # for (idx, column_name) in zip(taxonomy_ids_here[:(taxon_level_index+1)], Taxonomy.taxonomy_level_columns):
            #     to_print.append(idx)
            print('\t'.join(map(str, to_print)), file=tf)

            count += 1
            return count

        # In some cases, like c__Coriobacteriia in the 6_runs test dataset,
        # there is no actual entry for c__Coriobacteriia in the condensed
        # profile. So that searching condensed profiles for taxonomy returns
        # results for c__Coriobacteriia, we need to add an inferred entry.
        for (i, taxon) in enumerate(taxons):
            if taxonomy_name_to_id[taxonomy_type][taxon] not in inserted_taxonomy_ids:
                count = add_a_condensed_profile_taxon(count, taxon, i, tf)
                inserted_taxonomy_ids.add(taxonomy_name_to_id[taxonomy_type][taxon])

    return (taxonomy_name_to_id, next_taxonomy_id, count)


def iterate_condensed_profile_split_taxonomy(entries):
    for row in entries:
        taxonomies = row[2]
        taxons_split = taxonomies.split('; ')
        species_aware_taxonomies = []

        for (i, taxonomies_split) in enumerate(taxons_split):
            # Store species as species+genus since species aren't unique. But this already happens, so don't need to worry
            species_aware_taxonomy = taxonomies_split.strip()
            species_aware_taxonomies.append(species_aware_taxonomy)

        yield row, species_aware_taxonomies


def create_sample_metadata(db, condensed_otu_table_path, blacklist, kingfisher_annotate_files, corrections):
    '''Load metadata including directly parsed metadata, using only samples in the condensed otu table'''

    # Only load metadata for samples that are in the DB
    samples_of_interest = set([x[0] for x in iterate_condensed_profiles(condensed_otu_table_path, blacklist)])
    logging.info("Finding metadata for {} samples".format(len(samples_of_interest)))

    last_metadata_id = 0
    attribute_count = 0
    run_accession_to_id = {}
    num_corrections = 0
    for path in kingfisher_annotate_files:
        logging.info("Opening {}".format(path))
        with open(path) as f:
            # Read forcing str on all columns to avoid issues with "n/a" etc
            df = pl.read_csv(f, separator='\t', has_header=True, infer_schema=False)
            for j in df.rows(named=True):
                acc = j['run']
                if acc not in samples_of_interest:
                    logging.debug("Skipping {}".format(acc))
                    continue

                # Some odd (old?) runs do not have an associated bioproject e.g. SRR2001402
                if ('bioproject' in j and j['bioproject'] in corrections) or acc in corrections:
                    if acc in corrections:
                        items_here = corrections[acc].items()
                    else:
                        items_here = corrections[j['bioproject']].items()
                    for (field, correction) in items_here:
                        num_corrections += 1
                        if field in j:
                            if (type(correction['old_value']) == str and j[field] == correction['old_value']) or \
                                (type(correction['old_value']) == list and j[field] in correction['old_value']):
                                j[field] = correction['corrected_value']
                                logging.info("Correcting {}: '{}' from '{}' to '{}'".format(
                                    acc, field, correction['old_value'], correction['corrected_value']))
                            else:
                                msg = "For acc {} Did not find expected old value {} in {}".format(
                                    acc, correction['old_value'], j[field])
                                logging.error(msg)
                                # raise Exception()
                        else:
                            raise Exception("Unexpected correction field encountered: {}".format(field))
                
                # Must be done before any converstion to datetime.
                #
                # For historical reasons, convert each column into a k, v array
                # rather than a dict. This is not how the DB is structured, but
                # is how the JSON is structured. So we need to convert it.
                j2 = [{'k': column, 'v': j[column]} for column in j.keys()]
                attributes = prepare_attributes(j2)

                # del j['attributes']
                # Convert datetimes
                # releasedate = db.Column(db.DateTime, nullable=False)
                # loaddate = db.Column(db.DateTime, nullable=False)
                # collection_date_sam = db.Column(db.DateTime, nullable=False)
                for d in ['collection_date', 'published']:
                    if d in j and j[d] is not None and j[d].lower() not in ACTUALLY_MISSING:
                        try:
                            if d == 'collection_date':
                                new_key = 'collection_date_parsed'
                            else:
                                new_key = d
                            j[new_key] = iso8601.parse_date(j[d])
                        except iso8601.ParseError:
                            logging.warning("Unexpected date value for %s: %s" % (acc, j[d]))

                # if 'biosamplemodel' in j:
                #     del j['biosamplemodel_sam']  #Assume it is defined in the associated sample metadata

                # Create a new NcbiMetadata entry, which is the dict, but only include columns that are in the DB column names
                ncbi_metadata_columns = NcbiMetadata.__table__.columns.keys()
                # ncbi_metadata_datetime_columns = [col for col in ncbi_metadata_columns if NcbiMetadata.__table__.columns[col].type.python_type == datetime]
                for_ncbi_metadata = {}
                not_for_ncbi_metadata = {}
                for (k, v) in j.items():
                    if k in ncbi_metadata_columns and k != 'id': #.e.g ERR10798492
                        for_ncbi_metadata[k] = v
                    else:
                        if v is not None:
                            not_for_ncbi_metadata[k] = v
                for_ncbi_metadata['acc'] = acc
                del not_for_ncbi_metadata['run']

                meta = NcbiMetadata(**for_ncbi_metadata)
                db.session.add(meta)
                last_metadata_id += 1
                run_accession_to_id[acc] = last_metadata_id

                # Write biosample attributes
                for k, v in not_for_ncbi_metadata.items():
                    # Don't record bases/bytes as these aren't really biosample attributes
                    if k not in ('bases', 'bytes'):
                        attribute = {
                            'run_id': last_metadata_id,
                            'k': k,
                            'v': v
                        }
                        db.session.add(BiosampleAttribute(**attribute))
                        attribute_count += 1

                # Parsed data                            
                # Unclear to me why these exist as arrays rather than single values, but eh
                for d in ['geo_loc_name', 'ena_first_public_run', 'ena_last_update_run', 'sample_name']:
                    if d in attributes:
                        if len(attributes[d]) > 1:
                            logging.warning(
                                "Unexpectedly found a metadata array for {} in {}: {}, just taking the first one".
                                format(d, acc, j[d]))
                            attributes[d] = attributes[d][0]
                        try:
                            attributes[d] = attributes[d][0]
                        except IndexError:
                            del attributes[d]

                attributes = {
                    'acc': acc,
                    'attributes': attributes
                }
                lat_lon = parse_lat_lons(acc, parse_json_to_lat_lon_dict(attributes))
                # logging.info("Parsed lat_lon to {}".format(lat_lon))
                collection_year, collection_month = parse_extra_sample_attributes(attributes, ['collection_date'])
                if collection_year == '':
                    collection_year = None
                if collection_month == '':
                    collection_month = None
                depth = parse_extra_sample_attributes(attributes, ['depth'])[0]
                if depth == '':
                    depth = None
                temperature = parse_extra_sample_attributes(attributes, ['temperature'])[0]
                if temperature == '':
                    temperature = None
                db.session.add(
                    ParsedSampleAttribute(
                        **{
                            'run_id': last_metadata_id,
                            # 'collection_year': collection_year,
                            # 'collection_month': collection_month,
                            # 'depth': depth,
                            # 'temperature': temperature,
                            # 'latitude': lat_lon[0],
                            # 'longitude': lat_lon[1]
                        }))

                if last_metadata_id % 10000 == 0:
                    db.session.commit()

    db.session.commit()
    logging.info("Wrote {} metadata and {} attribute rows to DB, with {} corrections".format(
        last_metadata_id, attribute_count, num_corrections))

    return run_accession_to_id


def add_metadata_from_kingfisher_annotate(db, run_accession_to_id, kingfisher_annotate_path):
    '''Add metadata from kingfisher_annotate.json'''

    num_kingfisher_annotated = 0
    num_study_links = 0

    # On
    # sandpiper/sra_metadata/sra_metadata_20220524_kingfisher/sra_metadata_20220524.annotated315.tsv
    # was getting a buffer overflow error with the default engine
    df = pd.read_csv(kingfisher_annotate_path, sep='\t', header=0, engine='python')

    # experiment_title = db.Column(db.String)
    # library_strategy = db.Column(db.String)
    # instrument_model = db.Column(db.String) # model column in kingfisher
    # organisation_department = db.Column(db.String)
    # organisation_institution = db.Column(db.String)
    # organisation_street = db.Column(db.String)
    # organisation_city = db.Column(db.String)
    # organisation_country = db.Column(db.String)
    # organisation_contact_name = db.Column(db.String)
    # study_title = db.Column(db.String)
    # study_abstract = db.Column(db.String)
    # update_stmt = (
    #     update(NcbiMetadata).where(NcbiMetadata.id == bindparam('run_id')).values(
    #         experiment_title=bindparam('experiment_title'),  #row.experiment_title,
    #         library_strategy=bindparam('library_strategy'),  #row.library_strategy,
    #         instrument_model=bindparam('model'),  #row.model,
    #         # # meta.organisation_department = row.organisation_department
    #         # # meta.organisation_institution = row.organisation_institution
    #         # # meta.organisation_street = row.organisation_street
    #         # # meta.organisation_city = row.organisation_city
    #         # # meta.organisation_country = row.organisation_country
    #         # # meta.organisation_contact_name = row.organisation_contact_name
    #         study_title=bindparam('study_title'),  #row.study_title,
    #         study_abstract=bindparam('study_abstract'),  #row.study_abstract,
    #         design_description=bindparam('design_description'),  #row.design_description
    #         read1_length_average=bindparam('read1_length_average'),  #row.read1_length_average
    #         read1_length_stdev=bindparam('read1_length_stdev'),  #row.read1_length_stdev
    #         read2_length_average=bindparam('read2_length_average'),  #row.read2_length_average
    #         read2_length_stdev=bindparam('read2_length_stdev'),  #row.read2_length_stdev
    #     ))
    update_bindparams = []

    # Generate a mapping of run_id to id from NcbiMetadata
    run_acc_to_ncbi_metadata_id = {}
    for row in db.session.query(NcbiMetadata).all():
        run_acc_to_ncbi_metadata_id[row.acc] = row.id

    for row in df.itertuples():
        # Find associated NcbiMetadata record
        if row.run not in run_accession_to_id:
            # logging.warning("Skipping {} as there was no condense data for it".format(row.run))
            continue
        run_id = run_accession_to_id[row.run]

        update_bindparams.append({
            'id': run_acc_to_ncbi_metadata_id[row.run],
            'experiment_title': row.experiment_title,
            'library_strategy': row.library_strategy,
            'model': row.model,
            'organisation_name': row.organisation,
            'organisation_department': row.organisation_department,
            'organisation_institution': row.organisation_institution,
            'organisation_street': row.organisation_street,
            'organisation_city': row.organisation_city,
            'organisation_country': row.organisation_country,
            'organisation_contact_name': row.organisation_contact_name,
            'study_title': row.study_title,
            'study_abstract': row.study_abstract,
            'design_description': row.design_description,
            'read1_length_average': float(row.read1_length_average) if row.read1_length_average else None,
            'read1_length_stdev': float(row.read1_length_stdev) if row.read1_length_stdev else None,
            'read2_length_average': float(row.read2_length_average) if row.read2_length_average else None,
            'read2_length_stdev': float(row.read2_length_stdev) if row.read2_length_stdev else None,
        })

        for h in json.loads(row.study_links):
            if 'db' in h and 'id' in h:
                db.session.add(StudyLink(run_id=run_id, study_id=h['id'], database=h['db']))
            elif 'label' in h and 'url':
                db.session.add(StudyLink(run_id=run_id, label=h['label'], url=h['url']))
            else:
                raise Exception("Unexpected study link format: {}".format(h))
            num_study_links += 1

        num_kingfisher_annotated += 1

        if num_kingfisher_annotated % 10000 == 0:
            db.session.bulk_update_mappings(NcbiMetadata, update_bindparams)
            db.session.commit()
            bindparams = []

    if len(update_bindparams) > 0:
        db.session.bulk_update_mappings(NcbiMetadata, update_bindparams)
    db.session.commit()
    logging.info("Wrote {} metadata and {} study link rows to DB".format(num_kingfisher_annotated, num_study_links))


# Organism annotations whose recorded host/ecological label is unreliable.
# NCBI files all viral/phage metagenomes under "organismal metagenomes", which
# the upstream predictor equates with "host"; but a virome's host vs ecological
# status should come from its actual microbial community, not the annotation.
# Matched as substrings (lowercased) so new variants (e.g. "marine viral
# metagenome") are handled automatically without maintaining an explicit list.
HOST_LABEL_UNRELIABLE_ORGANISM_KEYWORDS = ('viral', 'phage', 'virome')


def _is_host_label_unreliable(organism):
    org = str(organism).lower()
    return any(keyword in org for keyword in HOST_LABEL_UNRELIABLE_ORGANISM_KEYWORDS)


# BioSample attribute keys that identify a genuine eukaryotic host for a sample.
# Presence of any of these (with a real value) means a viral/phage metagenome is
# host-associated (e.g. a sea lion or human virome) and must keep its recorded
# "host" label rather than being reassigned by the model.
HOST_EVIDENCE_ATTRIBUTE_KEYS = (
    'host', 'host_sam', 'host_scientific_name_sam', 'host_taxid_sam',
    'host_common_name_sam', 'specific_host_sam',
    'host_scientific_name', 'host_common_name', 'host_taxid', 'specific_host',
)

# Attribute values that look populated but carry no real host information.
HOST_VALUE_PLACEHOLDERS = frozenset({
    '', 'na', 'n/a', 'none', 'null', 'nan', 'missing', 'not applicable',
    'not collected', 'not provided', 'unknown', 'not determined',
    'not available', 'restricted access',
})


def _run_ids_with_host_evidence(db):
    """run_ids that have a real eukaryotic-host BioSample attribute."""
    keys_lower = [k.lower() for k in HOST_EVIDENCE_ATTRIBUTE_KEYS]
    rows = db.session.execute(
        select(BiosampleAttribute.run_id, BiosampleAttribute.v)
        .where(func.lower(BiosampleAttribute.k).in_(keys_lower))
    ).all()
    return {
        run_id for run_id, value in rows
        if str(value).strip().lower() not in HOST_VALUE_PLACEHOLDERS
    }


def add_host_predictions(db, run_accession_to_id, host_predictions_tsv):
    num_host_predicted = 0

    df = pd.read_csv(host_predictions_tsv, sep='\t')
    # acc     prediction      organism        host_or_not
    # DRR001356       host    human metagenome        host
    # DRR001360       ecological      human metagenome        host
    # DRR001455       ecological      soil metagenome ecological

    host_evidence_run_ids = _run_ids_with_host_evidence(db)
    logging.info("Found {} runs with genuine host BioSample evidence".format(
        len(host_evidence_run_ids)))

    update_bindparams = []

    for row in df.itertuples():
        # Find associated NcbiMetadata record
        if row.acc not in run_accession_to_id:
            logging.debug("Skipping {} as there was no condense data for it".format(row.acc))
            continue
        run_id = run_accession_to_id[row.acc]

        # Defer to the model prediction when the recorded label is missing, or
        # when the organism annotation has an unreliable host label (viral/phage
        # metagenomes wrongly inherit "host" from NCBI's tree). The guard keeps
        # the recorded "host" label for viral metagenomes that have genuine host
        # BioSample evidence (e.g. a sea lion or human virome), since the model
        # alone cannot be trusted to distinguish those from environmental ones.
        if str(row.host_or_not) == 'nan':
            host_or_not_mature = row.prediction
        elif _is_host_label_unreliable(row.organism) and run_id not in host_evidence_run_ids:
            host_or_not_mature = row.prediction
        else:
            host_or_not_mature = row.host_or_not

        update_bindparams.append({
            'id': run_id,
            'host_or_not_prediction': row.prediction,
            'host_or_not_recorded': row.host_or_not,
            'host_or_not_mature': host_or_not_mature
        })

        num_host_predicted += 1

        if num_host_predicted % 10000 == 0:
            db.session.bulk_update_mappings(ParsedSampleAttribute, update_bindparams)
            db.session.commit()
            update_bindparams = []

    if len(update_bindparams) > 0:
        db.session.bulk_update_mappings(ParsedSampleAttribute, update_bindparams)
    db.session.commit()
    logging.info("Wrote {} host predictions to DB".format(num_host_predicted))


def add_smf(db, run_accession_to_id, smf_tsv):
    num_smf_predictions = 0

    df = pd.read_csv(smf_tsv, sep=',')

    update_stmt = update(ParsedSampleAttribute).values(
        id=bindparam('id'),
        bacterial_archaeal_bases=bindparam('bacterial_archaeal_bases'),
        smf=bindparam('smf'),
        smf_warning=bindparam('smf_warning'),
        low_complexity=bindparam('low_complexity'),
        top1_order_fraction=bindparam('top1_order_fraction'),
        top3_order_fraction=bindparam('top3_order_fraction'),
    )

    update_bindparams = []

    # Test the assumption that id = run_id. Needs to be true otherwise we cannot
    # supply the id to the update statement using the run_id value
    stmt = db.select(func.count()).where(ParsedSampleAttribute.run_id != ParsedSampleAttribute.id)
    stmt = stmt.select_from(ParsedSampleAttribute)
    mismatch_count = db.session.execute(stmt).scalar()
    if mismatch_count > 0:
        raise Exception(
            "ParsedSampleAttribute.run_id != ParsedSampleAttribute.id. This is unexpected and needs to be fixed, or the code adjusted to work with it. Mismatch count: {}".format())

    for row in df.itertuples():
        # Find associated NcbiMetadata record
        if row.sample not in run_accession_to_id:
            logging.debug("Skipping {} as there was no condense data for it".format(row.sample))
            continue
        run_id = run_accession_to_id[row.sample]

        # # sample  bacterial_archaeal_bases        metagenome_size read_fraction   warning
        # bacterial_archaeal_bases = db.Column(db.Float)
        # smf = db.Column(db.Float)
        # smf_warning = db.Column(db.Boolean)
        update_bindparams.append({
            'id': run_id,
            'bacterial_archaeal_bases': row.bacterial_archaeal_bases,
            'smf': float(row.singlem_prokaryotic_fraction),
            'smf_warning': isinstance(row.warning, str) and row.warning != '',
            'low_complexity': row.low_complexity == 'yes',
            'top1_order_fraction': row.top1_order_fraction if str(row.top1_order_fraction) != 'nan' else None,
            'top3_order_fraction': row.top3_order_fraction if str(row.top3_order_fraction) != 'nan' else None,
        })

        num_smf_predictions += 1

        if num_smf_predictions % 10000 == 0:
            db.session.execute(update_stmt, update_bindparams)
            db.session.commit()
            update_bindparams = []

    db.session.execute(update_stmt, update_bindparams)
    db.session.commit()
    logging.info("Wrote {} SMF predictions to DB".format(num_smf_predictions))


def read_run_accession_to_id(db):
    # select NcbiMetadata.id, NcbiMetadata.acc
    # from NcbiMetadata -> return dict
    run_accession_to_id = {x[1]: x[0] for x in db.session.query(NcbiMetadata.id, NcbiMetadata.acc).all()}
    logging.info("Loaded {} run accessions".format(len(run_accession_to_id)))
    return run_accession_to_id


def read_taxonomy_name_to_id(db, taxonomy_type='gtdb'):
    # select Taxonomy.id, Taxonomy.name
    # from Taxonomy -> return dict
    taxonomy_name_to_id = {x[1]: x[0] for x in db.session.query(Taxonomy.id, Taxonomy.name)
                           .filter_by(taxonomy_type=taxonomy_type).all()}
    logging.info("Loaded {} taxonomies".format(len(taxonomy_name_to_id)))
    return taxonomy_name_to_id


def index_otu_table(db, otu_table_file, run_accession_to_id, taxonomy_name_to_id, db_path,
                    parquet_dir=None, load=True):
    """Create OTU parquet chunks and optionally load them into the DB."""

    logging.info("Creating and indexing OTU table")

    count = 0

    otus = StreamingOtuTableCollection()
    otus.add_otu_table_file(otu_table_file)

    # Get a list of the marker IDs
    marker_name_to_id = {}
    for marker in db.session.query(Marker).all():
        marker_name_to_id[marker.marker] = marker.id
    logging.info("Loaded {} markers".format(len(marker_name_to_id)))

    next_taxonomy_id = (db.session.query(func.max(Taxonomy.id)).scalar() or 0) + 1
    logging.info("Next taxonomy ID is {}".format(next_taxonomy_id))

    # Put Eukaryotes in as a special case, as these are never in the condensed
    # profile.
    if 'd__Eukaryota' not in taxonomy_name_to_id:  # which it currently never is
        taxon = 'd__Eukaryota'

        prefix = taxon.split('__')[0]
        level_id = ['d', 'p', 'c', 'o', 'f', 'g', 's'].index(prefix)
        level = ['domain', 'phylum', 'class', 'order', 'family', 'genus', 'species'][level_id]

        db.session.add(
            Taxonomy(id=next_taxonomy_id,
                     taxonomy_level=level,
                     parent_id=db.session.query(Taxonomy).filter_by(taxonomy_level='root', taxonomy_type='gtdb').first().id,
                     name=taxon,
                     full_name=taxon,
                     taxonomy_type='gtdb'))

        taxonomy_name_to_id[taxon] = next_taxonomy_id
        next_taxonomy_id += 1
    db.session.commit()

    if parquet_dir:
        os.makedirs(parquet_dir, exist_ok=True)
        my_tempdir = parquet_dir
    else:
        tmpdir = tempfile.TemporaryDirectory()
        my_tempdir = tmpdir.name

    conn = db.session.connection().connection
    # no preserve insertion order when using multiple threads
    conn.execute("PRAGMA preserve_insertion_order=false;")
    conn.execute("PRAGMA threads=8;")
    chunk_size = int(os.environ.get('OTU_CHUNK_SIZE', 10_000_000))
    rows = []
    chunk_index = 0
    for otu in tqdm(otus):
        if otu.sample_name in run_accession_to_id:
            split_taxonomy = [t for t in otu.taxonomy.split('; ') if t != '']
            try:
                taxonomy_name_to_id[split_taxonomy[-1]]
            except KeyError:
                i = len(split_taxonomy) - 1
                taxons_to_add = []
                while i >= 0:
                    if split_taxonomy[i] in taxonomy_name_to_id:
                        parent_id = taxonomy_name_to_id[split_taxonomy[i]]
                        break
                    taxons_to_add.append(split_taxonomy[i])
                    i -= 1
                if i == 0:
                    raise Exception(f"Strangely didn't find any taxonomy in the table for {otu.taxonomy}")
                taxons_to_add = reversed(taxons_to_add)
                full_taxonomy = split_taxonomy[1:(i + 1)]
                for taxon in taxons_to_add:
                    if split_taxonomy[1] == 'd__Eukaryota':
                        level_id = 0
                        level = 'phylum'
                    else:
                        prefix = taxon.split('__')[0]
                        level_id = ['d', 'p', 'c', 'o', 'f', 'g', 's'].index(prefix)
                        level = ['domain', 'phylum', 'class', 'order', 'family', 'genus', 'species'][level_id]
                    full_taxonomy.append(taxon)
                    logging.debug(f"Adding full name {full_taxonomy}")
                    db.session.add(
                        Taxonomy(id=next_taxonomy_id,
                                 taxonomy_level=level,
                                 parent_id=parent_id,
                                 name=taxon,
                                 full_name='; '.join(full_taxonomy),
                                 taxonomy_type='gtdb'))
                    db.session.flush()
                    taxonomy_name_to_id[taxon] = next_taxonomy_id
                    parent_id = next_taxonomy_id
                    next_taxonomy_id += 1
            rows.append([
                count + 1,
                run_accession_to_id[otu.sample_name],
                otu.count,
                otu.coverage,
                taxonomy_name_to_id[split_taxonomy[-1]],
                marker_name_to_id[otu.marker],
                otu.sequence,
            ])
            count += 1
            if len(rows) >= chunk_size:
                df = pl.DataFrame(rows, orient="row", schema=["id", "run_id", "num_hits", "coverage", "taxonomy_id", "marker_id", "sequence"])
                chunk_path = os.path.join(my_tempdir, f"chunk_{chunk_index}.parquet")
                df.write_parquet(chunk_path)
                rows = []
                chunk_index += 1
    if rows:
        df = pl.DataFrame(rows, orient="row", schema=["id", "run_id", "num_hits", "coverage", "taxonomy_id", "marker_id", "sequence"])
        chunk_path = os.path.join(my_tempdir, f"chunk_{chunk_index}.parquet")
        df.write_parquet(chunk_path)
    logging.info('Committing taxonomy entries seen only in OTU table ..')
    db.session.commit()

    if not load:
        logging.info(f"Wrote OTU parquet chunks to {my_tempdir}")
        if not parquet_dir:
            tmpdir.cleanup()
        return

    raise Exception("Bad code path, load should be false")


def load_otu_table_from_parquet(db, parquet_dir, db_path):
    """Load OTU parquet chunks into the database."""

    logging.info(f"Loading OTU parquet files from {parquet_dir} into DB")
    conn = db.session.connection().connection
    conn.execute("PRAGMA preserve_insertion_order=false;")
    conn.execute("PRAGMA threads=32;")
    
    parquet_files = glob.glob(os.path.join(parquet_dir, '*.parquet'))
    # Sort parquet files numerically by chunk number to maintain insertion order at least partially.
    parquet_files.sort(key=lambda x: int(os.path.basename(x).split('_')[1].split('.')[0]))

    # Drop indexes to speed up loading
    logging.info("Dropping indexes on otus_indexed ..")
    conn.execute("DROP INDEX IF EXISTS idx_otus_indexed_run_id;")
    conn.execute("DROP INDEX IF EXISTS idx_otus_indexed_taxonomy_id;")
    conn.execute("DROP INDEX IF EXISTS idx_otus_indexed_marker_id;")
    # Drop foreign keys constraints to speed up loading (apparently impossible at runtime)
    
    for i, parquet_file in enumerate(parquet_files):
        logging.info(f"Loading parquet file {i+1}/{len(parquet_files)}: {os.path.basename(parquet_file)}")
        conn.execute(f"COPY otus_indexed FROM '{parquet_file}' (FORMAT PARQUET);")

        ## If we commit here, it saves RAM. But the CPU cost is just too high, so just commit at the end.
        # if (i + 1) % 1000 == 0:
        #     logging.info(f"Committing ..")
        #     conn.commit()
    conn.commit()
    logging.info(f"Imported {db.session.query(OtuIndexed).count()} OTU lines into DB")

    logging.info("Recreating indexes on otus_indexed ..")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_otus_indexed_run_id ON otus_indexed (run_id);")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_otus_indexed_taxonomy_id ON otus_indexed (taxonomy_id);")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_otus_indexed_marker_id ON otus_indexed (marker_id);")
    conn.commit()

    logging.info("Dropping old otus table ..")
    Otu.__table__.drop(db.session.connection())


def read_corrections():
    try:
        with open(
            os.path.join(
                os.path.dirname(__file__),
                '../../public_sequencing_metadata_corrections/corrections.json',
            )
        ) as f:
            corrections = json.load(f)
    except FileNotFoundError:
        logging.warning('Corrections file not found; proceeding without overrides')
        return {}

    # Convert corrections to a dict with key of bioproject
    corrections_by_key = {}
    for correction in corrections:
        # Corrections should be dict of table name to correction info
        table_corrections = {}
        for cor in correction['corrections']:
            table_corrections[cor['field']] = cor
        if 'run' in correction and 'bioproject' in correction:
            raise Exception("Cannot specify both run and bioproject in corrections.json")
        if 'run' in correction:
            key = correction['run']
        elif 'bioproject' in correction:
            key = correction['bioproject']
        else:
            raise Exception("No project or run found in correction {}".format(correction))
        corrections_by_key[key] = table_corrections

    logging.debug("corrections_by_key:", corrections_by_key)
    return corrections_by_key


def add_host_prediction_counts_to_taxonomy(db, db_path):
    tax_count = db.session.query(Taxonomy).count()
    logging.info("Caching {} host sample counts in taxonomy ..".format(tax_count))

    # Fetch host/ecological run counts for all taxonomies in a single query
    results = (
        db.session.query(
            CondensedProfile.taxonomy_id,
            ParsedSampleAttribute.host_or_not_mature,
            func.count(func.distinct(CondensedProfile.run_id)),
        )
        .join(
            ParsedSampleAttribute,
            CondensedProfile.run_id == ParsedSampleAttribute.run_id,
        )
        .filter(
            ParsedSampleAttribute.host_or_not_mature.in_(("host", "ecological"))
        )
        .group_by(
            CondensedProfile.taxonomy_id,
            ParsedSampleAttribute.host_or_not_mature,
        )
        .all()
    )

    host_counts = {}
    ecological_counts = {}
    for tax_id, host_type, count in results:
        if host_type == "host":
            host_counts[tax_id] = count
        else:
            ecological_counts[tax_id] = count

    updates = []
    for tax_id in set(host_counts) | set(ecological_counts):
        updates.append(
            {
                "id": tax_id,
                "host_sample_count": host_counts.get(tax_id, 0),
                "ecological_sample_count": ecological_counts.get(tax_id, 0),
            }
        )

    if updates:
        db.session.bulk_update_mappings(Taxonomy, updates)
    db.session.commit()
    logging.info(
        "Imported {} taxonomies with host prediction counts".format(len(updates))
    )


def add_bioproject_associated_publications(db, db_path, tsv_path):
    df = pd.read_csv(tsv_path, sep='\t')
    logging.info("Adding {} bioproject associated publications to DB".format(df.shape[0]))
    count_added = 0
    first_id_to_add = db.session.query(StudyLink).count()
    # id = db.Column(db.Integer, primary_key=True)
    # run_id = db.Column(db.Integer, db.ForeignKey('ncbi_metadata.id'), nullable=False, index=True)
    # study_id = db.Column(db.String)
    # database = db.Column(db.String)
    # label = db.Column(db.String)
    # url = db.Column(db.String)

    logging.info("Caching known bioproject associated publications ..")
    run_id_to_study_link_data = {}
    for link in db.session.query(StudyLink).all():
        if link.run_id not in run_id_to_study_link_data:
            run_id_to_study_link_data[link.run_id] = []
        run_id_to_study_link_data[link.run_id].append(link)
    bioproject_to_run_ids = {}
    for row in db.session.query(NcbiMetadata).all():
        if row.bioproject in bioproject_to_run_ids:
            bioproject_to_run_ids[row.bioproject].append(row.id)
        else:
            bioproject_to_run_ids[row.bioproject] = [row.id]

    logging.info("Finding new bioproject associated publications to add ..")
    seen_bioproject_extras = set()
    with tempfile.NamedTemporaryFile(prefix='sandpiper_bioprojects_new') as f:
        for _, row in tqdm(df.iterrows(), total=df.shape[0]):
            key = '|'.join([row['bioproject'], str(row['id']), row['db']])
            if key in seen_bioproject_extras:
                continue
            else:
                seen_bioproject_extras.add(key)
            if row.bioproject not in bioproject_to_run_ids:
                logging.warning("Bioproject {} not found in DB".format(row.bioproject))
                continue
            run_ids = bioproject_to_run_ids[row.bioproject]
            for run_id in run_ids:
                try:
                    current_study_links = run_id_to_study_link_data[run_id]
                except KeyError:
                    current_study_links = []
                already_there = False
                # Remove duplicate links that are already recorded e.g. SRR9113719
                for link in current_study_links:
                    if link.database is not None and link.database.lower() == 'pubmed' and link.study_id == str(
                            row['id']):
                        already_there = True
                if not already_there:
                    count_added += 1
                    f.write(("\t".join(
                        [str(x) for x in [first_id_to_add + count_added, run_id, row['id'], row['db'], '', '']]) +
                             "\n").encode())

        f.flush()
        logging.info("Importing {} new bioproject associated publications to DB".format(count_added))
        # Import and set empty values as NULL
        conn = db.session.connection().connection
        conn.execute(
            f"COPY study_links FROM '{f.name}' (DELIMITER '\t');"
        )
        conn.execute("UPDATE study_links SET label=NULL WHERE label='';")
        conn.execute("UPDATE study_links SET url=NULL WHERE url='';")
        conn.commit()
        logging.info("Imported {} bioproject associated publications".format(count_added))

    logging.info("Added {} bioproject associated publications to DB".format(count_added))


def index_condensed_profiles_multi_column(db, db_path):
    # This vastly speeds up search by taxonomy
    logging.info("Indexing condensed profiles tax+relabund ..")
    conn = db.session.connection().connection
    conn.execute(
        'create index condensed_profiles_taxonomy_id_relative_abundance on '
        'condensed_profiles (taxonomy_id, relative_abundance);'
    )
    conn.commit()
    logging.info("Indexed condensed profiles tax+relabund")


def add_metagenome_classification_flags(db, db_path):
    '''Populate backend-only boolean classification columns on parsed_sample_attributes.

    These are not surfaced on the website (intentionally absent from
    ParsedSampleAttribute.to_displayable_dict). Each is a strict T/F (never NULL).

    Columns:
      non_metagenome_organism_strict - named single organism (no "metagenome"),
          excluding community-like terms AND generic/ambiguous terms (bacterium,
          unidentified, etc.)
      non_metagenome_organism_loose  - as strict, but INCLUDING the generic/ambiguous
          terms (still excludes clear community terms)
      synthetic                      - synthetic/simulated metagenome, synthetic
          construct, or library_source = SYNTHETIC
      rna_or_non_dna_strict          - RNA library strategies or
          TRANSCRIPTOMIC/METATRANSCRIPTOMIC library_source
      rna_or_non_dna_loose           - as strict, plus OTHER / SYNTHETIC library_source
    '''
    logging.info("Adding metagenome classification flags ..")
    conn = db.session.connection().connection

    # Community/environmental terms: genuine communities NCBI did not suffix with
    # "metagenome". Excluded from both non-metagenome flags.
    community_like = ['%uncultured%', '%environmental sample%', '%enrichment culture%',
                      '%mixed culture%', '%microbial community%', '%consortium%', '%microbiome%']
    community_clause = " OR ".join(
        "lower(n.taxon_name) LIKE '{}'".format(t) for t in community_like)

    # Generic/collective names too ambiguous to call a single organism; loose-only.
    ambiguous = ['bacterium', 'unidentified', 'archaeon', 'prokaryote', 'eukaryote',
                 'organism', 'microorganism', 'uncultured organism',
                 'unidentified prokaryotic organism',
                 'unclassified bacteria']
    ambiguous_clause = ",".join("'{}'".format(a) for a in ambiguous)

    # RNA-based library strategies (Synthetic-Long-Read is a sequencing tech, not RNA,
    # and is deliberately excluded).
    rna_strategies = ['RNA-Seq', 'miRNA-Seq', 'FL-cDNA', 'ssRNA-seq', 'ncRNA-Seq',
                      'RIP-Seq', 'Ribo-seq', 'EST']
    rna_strat_clause = ",".join("'{}'".format(s) for s in rna_strategies)

    sql = """
    UPDATE parsed_sample_attributes p
    SET
      non_metagenome_organism_loose = COALESCE((
        n.taxon_name IS NOT NULL
        AND lower(n.taxon_name) NOT LIKE '%metagenome%'
        AND NOT ({community})
      ), FALSE),
      non_metagenome_organism_strict = COALESCE((
        n.taxon_name IS NOT NULL
        AND lower(n.taxon_name) NOT LIKE '%metagenome%'
        AND NOT ({community})
        AND lower(n.taxon_name) NOT IN ({ambiguous})
      ), FALSE),
      synthetic = COALESCE((
        lower(n.taxon_name) LIKE '%synthetic%'
        OR lower(n.taxon_name) LIKE '%simulat%'
        OR EXISTS (SELECT 1 FROM biosample_attributes ba
                   WHERE ba.run_id = n.id AND ba.k = 'library_source'
                     AND upper(ba.v) = 'SYNTHETIC')
      ), FALSE),
      rna_or_non_dna_strict = COALESCE((
        n.library_strategy IN ({rna})
        OR EXISTS (SELECT 1 FROM biosample_attributes ba
                   WHERE ba.run_id = n.id AND ba.k = 'library_source'
                     AND upper(ba.v) IN ('METATRANSCRIPTOMIC','TRANSCRIPTOMIC SINGLE CELL','TRANSCRIPTOMIC'))
      ), FALSE),
      rna_or_non_dna_loose = COALESCE((
        n.library_strategy IN ({rna})
        OR EXISTS (SELECT 1 FROM biosample_attributes ba
                   WHERE ba.run_id = n.id AND ba.k = 'library_source'
                     AND upper(ba.v) IN ('METATRANSCRIPTOMIC','TRANSCRIPTOMIC SINGLE CELL','TRANSCRIPTOMIC','OTHER','SYNTHETIC'))
      ), FALSE)
    FROM ncbi_metadata n
    WHERE p.run_id = n.id;
    """.format(community=community_clause, ambiguous=ambiguous_clause, rna=rna_strat_clause)

    conn.execute(sql)
    conn.commit()

    for col in ['non_metagenome_organism_strict', 'non_metagenome_organism_loose',
                'synthetic', 'rna_or_non_dna_strict', 'rna_or_non_dna_loose']:
        n_true = conn.execute(
            "SELECT count(*) FROM parsed_sample_attributes WHERE {} = TRUE".format(col)).fetchone()[0]
        logging.info("  {} = TRUE: {}".format(col, n_true))
    logging.info("Added metagenome classification flags")


def add_domain_only_below_flag(db, db_path):
    # domain_only_both is TRUE only when the sample is domain-only under BOTH
    # taxonomies. The per-taxonomy flags (domain_only_gtdb / domain_only_globdb)
    # are set during the stage2 condensed loads; here we combine them. SQL
    # three-valued logic gives the intended NULL semantics: if either side is
    # NULL (no profile loaded for that sample under that taxonomy) the result is
    # NULL, unless the other side is FALSE (resolves deeper => not both).
    logging.info("Deriving domain_only_both from per-taxonomy domain-only flags ..")
    conn = db.session.connection().connection
    conn.execute(
        "UPDATE parsed_sample_attributes "
        "SET domain_only_both = domain_only_gtdb AND domain_only_globdb")
    conn.commit()
    for col in ['domain_only_gtdb', 'domain_only_globdb', 'domain_only_both']:
        n_true = conn.execute(
            "SELECT count(*) FROM parsed_sample_attributes WHERE {} = TRUE".format(col)).fetchone()[0]
        logging.info("  {} = TRUE: {}".format(col, n_true))
    logging.info("Derived domain_only_both")


def add_enriched_community_tags(db, db_path):
    # Add enriched community TAG
    logging.info("Adding enriched community tag ..")
    # An enriched community is one with >50% of a single genus

    # Create the enriched community tag
    db.session.add(
        Tag(name='enriched_community',
            description='Enriched community, one with a single genus comprising >50%% relative abundance'))
    db.session.commit()
    enriched_communities_tag_id = db.session.query(Tag).filter(Tag.name == 'enriched_community').one().id

    # select all runs with a condensed profile with a genus > 50%

    # enriched_communities = db.session.execute(select(CondensedProfile).filter(CondensedProfile.relative_abundance > 0.5)).all()
    enriched_communities_stmt = select(
        CondensedProfile.run_id).filter(CondensedProfile.relative_abundance > 0.5).distinct()
    # Require that the taxonomy_level is genus
    enriched_communities_stmt = enriched_communities_stmt.join(CondensedProfile.taxonomy).where(
        Taxonomy.taxonomy_level == 'genus')  # TODO: Change to genus for prod
    enriched_communities = list(db.session.execute(enriched_communities_stmt).scalars())
    logging.info("Found {} enriched communities. Adding tags..".format(len(enriched_communities)))

    # Add TagRun entries for each enriched community
    to_insert = []
    for run_id in enriched_communities:
        to_insert.append({'run_id': run_id, 'tag_id': enriched_communities_tag_id})
    if len(to_insert) > 0:  # not True for current test data
        db.session.execute(insert(RunTag), to_insert)
        db.session.commit()
    logging.info("Committed {} enriched community tags".format(
        db.session.execute(
            select(func.count()).select_from(RunTag).where(RunTag.tag_id == enriched_communities_tag_id)).scalar()))


def create_markers_table(db, describe_csv):
    with open(describe_csv) as f:
        reader = csv.DictReader(f, delimiter='\t')
        for row in reader:
            db.session.add(Marker(marker=row['name']))
    db.session.commit()


def add_parsed_metadata(db, run_accession_to_id, parsed_metadata):
    # e.g.
    # sample_name     latitude        longitude       depth   temperature     collection_year collection_month
    # ERR1914274                                      2014    1
    # SRR10875094
    # SRR3401492      35.43885        -138.26435                      2008    9
    # SRR7051324      38.7906 -75.1638                        2016    11

    df = pl.read_csv(parsed_metadata, separator='\t')
    logging.info("Adding {} parsed metadata to DB".format(df.shape[0]))
    updates = []
    cols_to_update = [col for col in df.columns if col != 'run']
    for row in tqdm(df.rows(named=True), total=df.shape[0]):
        if row['run'] not in run_accession_to_id:
            logging.debug("Skipping {} as there was no condense data for it".format(row['run']))
            continue  # No condensed data for this run I guess
        run_id = run_accession_to_id[row['run']]
        update = {'id': run_id}
        for col in cols_to_update:
            if row[col] is not None:
                update[col] = row[col]
        if len(update) > 1:
            updates.append(update)
    
    logging.info("Committing parsed metadata updates for {} samples to DB".format(len(updates)))
    db.session.bulk_update_mappings(ParsedSampleAttribute, updates)
    db.session.commit()
    logging.info("Added parsed metadata for {} samples to DB".format(len(updates)))


if __name__ == '__main__':
    parent_parser = argparse.ArgumentParser(add_help=False)
    parent_parser.add_argument('--debug', help='output debug information', action="store_true")
    #parent_parser.add_argument('--version', help='output version information and quit',  action='version', version=repeatm.__version__)
    parent_parser.add_argument('--quiet', help='only output errors', action="store_true")

    parent_parser.add_argument(
        '--otu-table', help='OTU table of the singlem db')  # Commented out for now since unsure it will be used.
    parent_parser.add_argument('--condensed-otu-table', help='condensed OTU table input')
    parent_parser.add_argument('--condensed-otu-table-taxonomy-type',
                               help='taxonomy type for condensed OTU table (default: gtdb)',
                               choices=['gtdb', 'globdb'], default='gtdb')
    parent_parser.add_argument('--globdb-condensed-otu-table',
                               help='condensed OTU table input built on globdb taxonomy')
    parent_parser.add_argument('-o', help='duckdb file to generate', required=True)
    parent_parser.add_argument('--metapackage-describe', help='metapackage describe CSV file')
    parent_parser.add_argument('--metadata-json-files', nargs='+', help='metadata json files')
    parent_parser.add_argument('--run-blacklist', help='Ignore runs listed in this file')
    parent_parser.add_argument('--kingfisher-annotate-path', help='kingfisher annotate TSV output')
    parent_parser.add_argument('--kingfisher-annotate-path-list',
                               help='kingfisher annotate TSV outputs listed in this file, one per line')
    parent_parser.add_argument('--host-predictions-tsv', help='host predictions TSV output')
    parent_parser.add_argument('--bioproject-associated-publications', help='tsv from bioprjoect_metadata.py')
    parent_parser.add_argument('--smf-file', help='SMF file to read')
    parent_parser.add_argument('--parsed-metadata-table', help='parsed metadata table to read')
    parent_parser.add_argument('--otu-parquet-dir', help='directory for OTU parquet chunks')

    parent_parser.add_argument('--stage', help='processing stage to run', choices=['start', 'taxonomy_upload', 'stage2', 'update_smf', 'tags', 'otus_parquet', 'otus_load', 'parsed_metadata'], required=True)

    parent_parser.add_argument('--gtdb-archaea-taxonomy', help='GTDB archaea taxonomy TSV (two columns: accession, taxonomy)')
    parent_parser.add_argument('--gtdb-bacteria-taxonomy', help='GTDB bacteria taxonomy TSV (two columns: accession, taxonomy)')
    parent_parser.add_argument('--globdb-taxonomy', help='GlobDB taxonomy TSV (two columns: accession, taxonomy)')

    args = parent_parser.parse_args()

    if args.stage == 'start' and not args.kingfisher_annotate_path and not args.kingfisher_annotate_path_list:
        raise Exception("Kingfisher annotate data must be specified somehow")

    # Setup logging
    if args.debug:
        loglevel = logging.DEBUG
    elif args.quiet:
        loglevel = logging.ERROR
    else:
        loglevel = logging.INFO
    logging.basicConfig(level=loglevel, format='%(asctime)s %(levelname)s: %(message)s', datefmt='%m/%d/%Y %I:%M:%S %p')

    # Set 'SANDPIPER_LOADING_DATA'):
    os.environ['SANDPIPER_LOADING_DATA'] = '1'

    # Create the app and create the tables
    db_path = args.o
    app = generate_app()
    app.config['SQLALCHEMY_DATABASE_URI'] = 'duckdb:///' + db_path
    app.config['SQLALCHEMY_ECHO'] = args.debug is True
    db.init_app(app)
    with app.app_context():
        #register_duckdb_limits(db.engine)
        if args.stage == 'start' or args.stage == 'stage2':
            blacklist = set()
            if args.run_blacklist:
                with open(args.run_blacklist) as f:
                    for line in f:
                        if line != 'acc':
                            blacklist.add(line.strip())
                logging.info("Ignoring {} runs".format(len(blacklist)))
            else:
                logging.info("No run blacklist specified")
                blacklist = set()
            
        if args.stage == 'start':
            if not args.metapackage_describe:
                raise Exception("metapackage-describe must be specified for stage 'start'")
            if not args.condensed_otu_table:
                raise Exception("condensed-otu-table must be specified for stage 'start'")
            # if not args.metadata_json_files:
            #     raise Exception("metadata-json-files must be specified for stage 'start'")

            # Read corrections in
            corrections = read_corrections()

            # Create new DB
            logging.info("Removing old DB if it exists ..")
            if os.path.exists(db_path):
                os.remove(db_path)
            logging.info("Making new DB ..")
            conn = duckdb.connect(db_path)
            configure_duckdb_connection(conn)
            # Create sequences for autoincrementing IDs
            seqs = [
                'otus_id_seq',
                'otus_indexed_id_seq',
                'markers_id_seq',
                'nucleotides_id_seq',
                'condensed_profiles_id_seq',
                'taxonomies_id_seq',
                'biosample_attributes_id_seq',
                'parsed_sample_attributes_id_seq',
                'study_links_id_seq',
                'ncbi_metadata_id_seq',
                'tags_id_seq',
                'run_tags_id_seq',
            ]
            for seq in seqs:
                conn.execute(f"CREATE SEQUENCE {seq}")
            conn.close()

            # Create all the tables
            db.create_all()

            # Create markers
            create_markers_table(db, args.metapackage_describe)

            kingfisher_metadata_file_paths = []
            if args.kingfisher_annotate_path:
                kingfisher_metadata_file_paths = [args.kingfisher_annotate_path]
            if args.kingfisher_annotate_path_list:
                with open(args.kingfisher_annotate_path_list) as f:
                    for line in f:
                        file_path = line.strip()
                        kingfisher_metadata_file_paths.append(file_path)

            # Create sample metadata table, restricting it to just those samples
            # that we have condensed profiles for.
            run_accession_to_id = create_sample_metadata(db, args.condensed_otu_table, blacklist,
                                                         kingfisher_metadata_file_paths, corrections)

        elif args.stage == 'taxonomy_upload':
            if not args.gtdb_archaea_taxonomy:
                raise Exception("gtdb-archaea-taxonomy must be specified for stage 'taxonomy_upload'")
            if not args.gtdb_bacteria_taxonomy:
                raise Exception("gtdb-bacteria-taxonomy must be specified for stage 'taxonomy_upload'")

            starting_taxonomy_entries = db.session.query(func.count()).select_from(Taxonomy).scalar()
            taxonomy_name_to_id = load_taxonomy_name_to_id(db)
            next_taxonomy_id = get_next_taxonomy_id(db)

            taxonomy_name_to_id, next_taxonomy_id = add_taxonomy_from_tsv(
                db, args.gtdb_archaea_taxonomy, 'gtdb', taxonomy_name_to_id, next_taxonomy_id)
            taxonomy_name_to_id, next_taxonomy_id = add_taxonomy_from_tsv(
                db, args.gtdb_bacteria_taxonomy, 'gtdb', taxonomy_name_to_id, next_taxonomy_id)
            if args.globdb_taxonomy:
                taxonomy_name_to_id, next_taxonomy_id = add_taxonomy_from_tsv(
                    db, args.globdb_taxonomy, 'globdb', taxonomy_name_to_id, next_taxonomy_id)

            db.session.commit()
            final_taxonomy_entries = db.session.query(func.count()).select_from(Taxonomy).scalar()
            logging.info(
                "Committed taxonomy uploads. Added {} new taxonomy entries.".format(
                    final_taxonomy_entries - starting_taxonomy_entries))

        elif args.stage == 'stage2':
            if not args.host_predictions_tsv:
                raise Exception("host-predictions-tsv must be specified for stage 'stage2'")
            if not args.bioproject_associated_publications:
                raise Exception("bioproject-associated-publications must be specified for stage 'stage2'")
            if not args.smf_file:
                raise Exception("smf-file must be specified for stage 'stage2'")

            run_accession_to_id = read_run_accession_to_id(db)

            required_taxonomy_types = ['gtdb']
            if args.globdb_condensed_otu_table:
                required_taxonomy_types.append('globdb')
            taxonomy_name_to_id = load_taxonomy_name_to_id(db, required_taxonomy_types)
            missing_taxonomy_types = [t for t in required_taxonomy_types if t not in taxonomy_name_to_id]
            if missing_taxonomy_types:
                missing_taxonomy_list = ', '.join(missing_taxonomy_types)
                raise Exception(
                    f"Taxonomy types missing from DB: {missing_taxonomy_list}. Run taxonomy_upload stage first.")
            next_taxonomy_id = get_next_taxonomy_id(db)

            add_smf(db, run_accession_to_id, args.smf_file)

            condensed_taxonomy_type = args.condensed_otu_table_taxonomy_type
            taxonomy_name_to_id, next_taxonomy_id = fill_condensed_and_taxonomy_tables(
                db, db_path, args.condensed_otu_table,
                blacklist, run_accession_to_id, condensed_taxonomy_type, taxonomy_name_to_id, next_taxonomy_id,
                allow_new_taxa=(condensed_taxonomy_type == 'globdb'))

            if args.globdb_condensed_otu_table:
                taxonomy_name_to_id, next_taxonomy_id = fill_condensed_and_taxonomy_tables(
                    db, db_path, args.globdb_condensed_otu_table,
                    blacklist, run_accession_to_id, 'globdb', taxonomy_name_to_id, next_taxonomy_id,
                    allow_new_taxa=True) # Have to allow new taxa here because of the strange s__F0422 sp916438745 case that I emailed Daan about (and maybe more).

            add_bioproject_associated_publications(db, db_path, args.bioproject_associated_publications)

            add_host_predictions(db, run_accession_to_id, args.host_predictions_tsv)
        
            add_host_prediction_counts_to_taxonomy(db, db_path)

            index_condensed_profiles_multi_column(db, db_path)

        elif args.stage == 'update_smf':
            if not args.smf_file:
                raise Exception("smf-file must be specified for stage 'update_smf'")
            run_accession_to_id = read_run_accession_to_id(db)
            add_smf(db, run_accession_to_id, args.smf_file)

        elif args.stage == 'tags':
            add_enriched_community_tags(db, db_path)
            add_metagenome_classification_flags(db, db_path)
            add_domain_only_below_flag(db, db_path)

        elif args.stage == 'otus_parquet':
            if not args.otu_table or not args.otu_parquet_dir:
                raise Exception("otu-table and otu-parquet-dir must be specified for stage {}".format(args.stage))

            run_accession_to_id = read_run_accession_to_id(db)
            taxonomy_name_to_id = read_taxonomy_name_to_id(db)
            index_otu_table(db, args.otu_table, run_accession_to_id, taxonomy_name_to_id, db_path,
                            parquet_dir=args.otu_parquet_dir, load=False)

        elif args.stage == 'otus_load':
            if not args.otu_parquet_dir:
                raise Exception("otu-parquet-dir must be specified for stage {}".format(args.stage))

            load_otu_table_from_parquet(db, args.otu_parquet_dir, db_path)

        elif args.stage == 'parsed_metadata':
            # --parsed-metadata-table
            if not args.parsed_metadata_table:
                raise Exception("parsed-metadata-table must be specified for stage {}".format(args.stage))

            run_accession_to_id = read_run_accession_to_id(db)
            add_parsed_metadata(db, run_accession_to_id, args.parsed_metadata_table)

        else:
            raise Exception("Unknown stage {}".format(args.stage))